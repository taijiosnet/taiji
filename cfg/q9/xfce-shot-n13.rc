#!/bin/rc
# dbus FIRST (ufs is healthiest at boot; its config read hung when
# launched later), then the X stack. Conf was written host-side.
rm -f /debian/rootfs/tmp/dbus-1 /debian/rootfs/tmp/dbus-1.req
debian-session -c 'linuxrun /usr/bin/dbus-daemon --config-file /usr/share/dbus-1/dbus-run.conf --nofork --nopidfile' &
sleep 20
echo dbus-phase
mkdir -p /debian/rootfs/tmp/.X11-unix
rm -f /debian/rootfs/tmp/.X0-lock /debian/rootfs/tmp/.X11-unix/X0.req /debian/rootfs/tmp/.X11-unix/X0.q
debian-session -c 'linuxrun /usr/bin/Xvfb :0 -screen 0 1024x768x24' &
sleep 75
echo xvfb-up
debian-session -c 'linuxrun /usr/bin/xeyes -display :0 -geometry +400+300' &
sleep 300
echo xeyes-phase
debian-session -c 'env DBUS_SESSION_BUS_ADDRESS=unix:path=/tmp/dbus-1 linuxrun /usr/bin/xfwm4 --display :0' &
sleep 240
echo xfwm4-phase
debian-session -c 'linuxrun /usr/bin/xwd -root -out /tmp/shot9.xwd' &
sleep 900
echo shot-try1
ls -l /debian/rootfs/tmp/shot9.xwd
cp /debian/rootfs/tmp/shot9.xwd /debian/rootfs/shot1.xwd
echo xfce-shot-done
