#!/bin/sh

set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$root"

state=boot/q9
rundir=cfg/q9
runrc=$rundir/run.rc
predesktoprc=$rundir/predesktop.rc
kernelpxe=
seriallog=$state/serial.log
serialsock=$root/$state/serial.sock
monitorsock=$root/$state/monitor.sock
sessionstate=$root/$state/session.vmstate
sessiontmp=$root/$state/session.vmstate.tmp
sessionlock=$root/$state/session.lock
sessionmeta=$root/$state/session.kind
runlock=$root/$state/run.lock
buildlog=$state/build.log
qemulog=$state/qemu.log
socatlog=$state/socat.log
monitorlog=$state/monitor.log
copiedimage=
driveimage=
snapshotarg=-snapshot

TMPDIR=${Q9_TMPDIR:-${TMPDIR:-/tmp}}
export TMPDIR

qemu=${QEMU:-qemu-system-x86_64}
image=${Q9_IMAGE:-boot/pxeboot.raw}
textmac=${Q9_MAC:-52:54:00:12:34:57}
guimac=${Q9_GUI_MAC:-52:54:00:12:34:58}
mac=$guimac
mem=${Q9_MEM:-1G}
smp=${Q9_SMP:-1}
netdevice=${Q9_NET_DEVICE:-virtio-net-pci}
gpu=${Q9_GPU:-vesa}
qemuvga=
boottimeout=${Q9_BOOT_TIMEOUT:-120}
profile=true
textonly=false
autosave=${Q9_CHECKPOINT:-0}
builddesktop=${Q9_BUILD_DESKTOP:-0}
kernel=${Q9_KERNEL:-}
kernelmac=${Q9_KERNEL_MAC:-52:54:00:12:34:59}
vmwaremac=${Q9_VMWARE_MAC:-52:54:00:12:34:5a}
fresh=false
hadsession=false
headless=false

usage()
{
	status=${1:-1}
	cat >&2 <<EOF
usage: ./q9 [--text] [--mini] [--raw] [--headless] [--fresh] [--no-autosave] [--rebuild-desktop] [--kernel name|path] [--smp n] [--net-device model] [--gpu model] [console|shell|tty|gui]
       ./q9 [--text] [--mini] [--raw] [--rebuild-desktop] [--kernel name|path] [--smp n] [--net-device model] [--gpu model] run command
       ./q9 [--mini] [--raw] [--kernel name|path] [--smp n] [--net-device model] [--gpu model] tty-run command
       ./q9 [--mini] [--raw] [--kernel name|path] [--smp n] [--net-device model] [--gpu model] acme|rill [args...]

Default mode boots Glenda's normal graphical TaijiOS profile.
Default graphical mode cold-boots reliably. QEMU vmstate checkpoints are
disabled by default because restored u9fs mounts can hang demand-loaded binaries.

Use --text, tty, or shell to boot a clean rc console on QEMU serial stdio.
Use --fresh to ignore an experimental checkpoint for this run.
Set Q9_CHECKPOINT=1 to try experimental pre-desktop checkpoint save/resume.
Use --rebuild-desktop or Q9_BUILD_DESKTOP=1 to rebuild desktop tools before graphical launch.
Use --kernel name or Q9_KERNEL=name to boot /386/9name, or pass an explicit path.
Use --smp n or Q9_SMP=n to expose n CPUs to QEMU.
Use --net-device model or Q9_NET_DEVICE=model to test a QEMU NIC model.
Use --gpu vesa|vmware or Q9_GPU=vesa|vmware to select the QEMU display adapter.
TaijiOS MP stays disabled in q9 profiles until the LAPIC clock panic is fixed.
EOF
	exit "$status"
}

mkdir -p "$state" "$rundir"

raw=false
while [ $# -gt 0 ]; do
	case "$1" in
	--gui|-g)
		profile=true
		mac=$guimac
		shift
		;;
	--text|-t)
		profile=false
		mac=$textmac
		shift
		;;
	--mini)
		image=boot/mini.raw
		shift
		;;
	--headless)
		headless=true
		shift
		;;
	--raw)
		raw=true
		shift
		;;
	--fresh)
		fresh=true
		shift
		;;
	--no-autosave)
		autosave=0
		shift
		;;
	--checkpoint)
		autosave=1
		shift
		;;
	--rebuild-desktop)
		builddesktop=1
		shift
		;;
	--no-rebuild-desktop)
		builddesktop=0
		shift
		;;
	--kernel)
		[ $# -ge 2 ] || usage
		kernel=$2
		shift 2
		;;
	--smp)
		[ $# -ge 2 ] || usage
		case "$2" in
		*[!0-9]*|'')
			echo "q9: --smp needs a positive integer" >&2
			exit 1
			;;
		esac
		if [ "$2" -lt 1 ]; then
			echo "q9: --smp needs a positive integer" >&2
			exit 1
		fi
		smp=$2
		shift 2
		;;
	--net-device)
		[ $# -ge 2 ] || usage
		netdevice=$2
		shift 2
		;;
	--gpu)
		[ $# -ge 2 ] || usage
		gpu=$2
		shift 2
		;;
	--help|-h)
		usage 0
		;;
	*)
		break
		;;
	esac
done

mode=console
if [ $# -gt 0 ]; then
	mode=$1
	shift
fi

case "$mode" in
gui)
	mode=console
	profile=true
	mac=$guimac
	;;
shell|text|tty|sh)
	mode=console
	profile=false
	mac=$textmac
	textonly=true
	;;
tty-run)
	mode=run
	profile=false
	mac=$textmac
	textonly=true
	;;
acme|rill)
	set -- "$mode" "$@"
	mode=run
	profile=false
	mac=$textmac
	;;
esac

if [ "$mode" = run ] && [ "$profile" = true ]; then
	profile=false
	mac=$textmac
fi
if [ "$mode" = run ] && [ "$raw" != true ] && { [ ! -t 0 ] || [ ! -t 1 ]; }; then
	raw=true
fi

case "$gpu" in
''|vesa|std|standard)
	gpu=vesa
	qemuvga=
	;;
vmware|vmware-svga)
	gpu=vmware
	qemuvga=vmware
	;;
*)
	echo "q9: unknown GPU model: $gpu" >&2
	echo "q9: supported GPU models: vesa, vmware" >&2
	exit 1
	;;
esac
if [ "$gpu" = vmware ] && [ "$textonly" != true ] &&
    { [ "$profile" = true ] || [ "$mode" = run ]; }; then
	mac=$vmwaremac
fi

basemac=$mac
if [ "$kernel" ]; then
	mac=$kernelmac
fi

pxe_id()
{
	printf '%s\n' "$1" | tr -d ':' | tr 'ABCDEF' 'abcdef'
}

resolve_kernel_bootfile()
{
	k=$1
	case "$k" in
	*!*)
		bootfile=$k
		;;
	/*)
		bootfile=ether0!"$k"
		;;
	*/*)
		bootfile=ether0!/"$k"
		;;
	9*)
		bootfile=ether0!/386/"$k"
		;;
	*)
		bootfile=ether0!/386/9"$k"
		;;
	esac
	path=${bootfile#*!}
	case "$path" in
	/*)
		hostpath=$root$path
		;;
	*)
		hostpath=$root/$path
		;;
	esac
	if [ ! -r "$hostpath" ]; then
		echo "q9: kernel not found for $k: $hostpath" >&2
		exit 1
	fi
	printf '%s\n' "$bootfile"
}

write_kernel_pxe()
{
	[ "$kernel" ] || return 0
	bootfile=$(resolve_kernel_bootfile "$kernel")
	src=cfg/pxe/$(pxe_id "$basemac")
	kernelpxe=cfg/pxe/$(pxe_id "$mac")
	if [ "$src" = "$kernelpxe" ]; then
		echo "q9: Q9_KERNEL_MAC must differ from the base q9 MAC" >&2
		exit 1
	fi
	if [ ! -r "$src" ]; then
		echo "q9: base PXE profile not found: $src" >&2
		exit 1
	fi
	tmp=$kernelpxe.$$
	awk -v bootfile="$bootfile" '
		BEGIN { done = 0 }
		/^bootfile=/ && done == 0 {
			print "bootfile=" bootfile
			done = 1
			next
		}
		{ print }
		END {
			if(done == 0)
				print "bootfile=" bootfile
		}
	' "$src" >"$tmp"
	mv "$tmp" "$kernelpxe"
	echo "q9: using kernel $kernel ($bootfile)" >&2
}

build_u9fs()
{
	u9fsbin=sys/src/cmd/unix/u9fs/u9fs
	if [ "${Q9_REBUILD:-0}" != 1 ] && [ -x "$u9fsbin" ]; then
		if make -q -C sys/src/cmd/unix/u9fs >"$buildlog" 2>&1; then
			return
		fi
	fi
	if ! make -C sys/src/cmd/unix/u9fs >"$buildlog" 2>&1; then
		cat "$buildlog" >&2
		exit 1
	fi
}

write_runrc()
{
	cmd=$1
	tmp=$runrc.$$
	{
		printf '#!/bin/rc\n'
		printf 'echo q9: running /cfg/q9/run.rc\n'
		printf '%s\n' "$cmd"
	} >"$tmp"
	mv "$tmp" "$runrc"
}

clear_runrc()
{
	rm -f "$runrc" "$runrc".* "$predesktoprc" "$predesktoprc".*
	if [ "${kernelpxe:-}" ]; then
		rm -f "$kernelpxe" "$kernelpxe".*
	fi
}

write_predesktoprc()
{
	tmp=$predesktoprc.$$
	if [ "$profile" = true ] && [ "$textonly" != true ] && [ "$builddesktop" = 1 ]; then
		{
			printf '#!/bin/rc\n'
			if [ "${Q9_TEST:-0}" = 1 ]; then
				printf 'q9splashslow=1\n'
			fi
			printf 'echo q9: rebuilding desktop tools\n'
			printf 'echo q9: checking kryon\n'
			printf 'cd /sys/src/kryon\n'
			printf 'mk install\n'
			printf 'echo q9: checking ktrem\n'
			printf 'cd /sys/src/ktrem\n'
			printf 'mk install\n'
			printf 'echo q9: checking shelf\n'
			printf 'cd /sys/src/shelf\n'
			printf 'mk install\n'
			printf 'echo q9: checking inbe\n'
			printf 'cd /sys/src/inbe\n'
			printf 'mk install\n'
			printf 'echo q9: checking pass\n'
			printf 'cd /sys/src/pass\n'
			printf 'mk install\n'
			for component in rio9 linuxrun xbridge; do
				printf 'echo q9: checking %s\n' "$component"
				printf 'cd /sys/src/cmd/%s\n' "$component"
				printf 'mk install\n'
			done
			printf 'echo q9: checking rill\n'
			printf 'cd /sys/src/cmd/rill\n'
			printf 'mk install\n'
		} >"$tmp"
	else
		{
			printf '#!/bin/rc\n'
			if [ "$profile" = true ] && [ "$textonly" != true ]; then
				printf 'echo q9: using installed desktop tools\n'
			fi
		} >"$tmp"
	fi
	mv "$tmp" "$predesktoprc"
}

cleanup_runtime()
{
	rm -f "$serialsock" "$monitorsock"
	if [ "${copiedimage:-}" ]; then
		rm -f "$copiedimage"
	fi
	rmdir "$sessionlock" 2>/dev/null || true
	rm -f "$runlock/pid" 2>/dev/null || true
	rmdir "$runlock" 2>/dev/null || true
}

prepare_drive_image()
{
	case "$image" in
	/*)
		srcimage=$image
		;;
	*)
		srcimage=$root/$image
		;;
	esac
	driveimage=$srcimage
	snapshotarg=-snapshot
	if [ "${Q9_COPY_IMAGE:-0}" = 1 ]; then
		copiedimage=$TMPDIR/q9-image-$$.raw
		cp "$srcimage" "$copiedimage"
		driveimage=$copiedimage
		snapshotarg=
	fi
}

qemu_autosave()
{
	[ "$autosave" = 1 ] || return 1
	[ "$profile" = true ] || return 1
	[ "$mode" = console ] || return 1
	[ "$raw" != true ] || return 1
	[ "$textonly" != true ] || return 1
	return 0
}

has_checkpoint()
{
	[ -s "$sessionstate" ] || return 1
	[ -r "$sessionmeta" ] || return 1
	grep -q "^pre-desktop $gpu$" "$sessionmeta" && return 0
	[ "$gpu" = vesa ] && grep -q '^pre-desktop$' "$sessionmeta"
}

acquire_runlock()
{
	pid=
	if mkdir "$runlock" 2>/dev/null; then
		printf '%s\n' "$$" >"$runlock/pid"
		return 0
	fi
	if [ -r "$runlock/pid" ]; then
		pid=$(cat "$runlock/pid" 2>/dev/null || true)
	fi
	if [ "$pid" ] && kill -0 "$pid" 2>/dev/null; then
		echo "q9: graphical session already running as pid $pid" >&2
		exit 1
	fi
	rm -f "$runlock/pid" 2>/dev/null || true
	rmdir "$runlock" 2>/dev/null || true
	if mkdir "$runlock" 2>/dev/null; then
		printf '%s\n' "$$" >"$runlock/pid"
		return 0
	fi
	echo "q9: could not acquire run lock: $runlock" >&2
	exit 1
}

wait_for_socket()
{
	i=0
	while [ "$i" -lt 10 ]; do
		if [ -S "$serialsock" ]; then
			return 0
		fi
		sleep 1
		i=$((i + 1))
	done
	echo "q9: timed out waiting for serial socket: $serialsock" >&2
	return 1
}

wait_for_monitor()
{
	i=0
	while [ "$i" -lt 10 ]; do
		if [ -S "$monitorsock" ]; then
			return 0
		fi
		sleep 1
		i=$((i + 1))
	done
	echo "q9: timed out waiting for QEMU monitor: $monitorsock" >&2
	return 1
}

hmp()
{
	printf '%s\n' "$1" | socat - "UNIX-CONNECT:$monitorsock" 2>>"$monitorlog"
}

wait_for_incoming()
{
	i=0
	while [ "$i" -lt 60 ]; do
		out=$(hmp 'info migrate' || true)
		printf '%s\n' "$out" >>"$monitorlog"
		if printf '%s\n' "$out" | grep -qi 'completed'; then
			return 0
		fi
		if printf '%s\n' "$out" | grep -Eqi 'failed|cancelled|error'; then
			echo 'q9: saved checkpoint restore failed' >&2
			return 1
		fi
		sleep 1
		i=$((i + 1))
	done
	echo 'q9: timed out restoring saved checkpoint' >&2
	return 1
}

save_session()
{
	i=0
	action=${1:-quit}

	[ "${qemupid:-}" ] || return 0
	kill -0 "$qemupid" 2>/dev/null || return 0
	wait_for_monitor || return 0
	if ! mkdir "$sessionlock" 2>/dev/null; then
		return 0
	fi
	rm -f "$sessiontmp"
	if ! {
		printf 'stop\n'
		printf 'migrate "exec:cat > %s"\n' "$sessiontmp"
	} | socat - "UNIX-CONNECT:$monitorsock" >>"$monitorlog" 2>&1; then
		if [ "$action" = continue ]; then
			hmp 'cont' >/dev/null 2>&1 || true
		fi
		rmdir "$sessionlock" 2>/dev/null || true
		return 0
	fi
	while [ "$i" -lt 60 ]; do
		if hmp 'info migrate' | grep -qi 'completed'; then
			if [ -s "$sessiontmp" ]; then
				mv "$sessiontmp" "$sessionstate"
				printf 'pre-desktop %s\n' "$gpu" >"$sessionmeta"
				echo "q9: saved session: $sessionstate" >&2
			fi
			if [ "$action" = continue ]; then
				hmp 'cont' >/dev/null 2>&1 || true
			else
				hmp 'quit' >/dev/null 2>&1 || true
			fi
			rmdir "$sessionlock" 2>/dev/null || true
			return 0
		fi
		sleep 1
		i=$((i + 1))
	done
	echo 'q9: timed out while saving session' >&2
	if [ "$action" = continue ]; then
		hmp 'cont' >/dev/null 2>&1 || true
	fi
	rm -f "$sessiontmp"
	rmdir "$sessionlock" 2>/dev/null || true
}

qemu_common()
{
	if [ -z "${driveimage:-}" ]; then
		case "$image" in
		/*)
			driveimage=$image
			;;
		*)
			driveimage=$root/$image
			;;
		esac
	fi
	u9fs="guestfwd=tcp:10.0.2.1:564-cmd:$root/sys/src/cmd/unix/u9fs/u9fs -a none -u ${USER:-none} $root"
	if [ "$headless" = true ]; then
		set -- -display none -vnc 127.0.0.1:${Q9_VNC_DISPLAY:-1} \
			-monitor "unix:$monitorsock,server=on,wait=off" "$@"
	fi
	if [ "$qemuvga" ]; then
		set -- -vga "$qemuvga" "$@"
	fi
	tftp="tftp=$root"
	if qemu_autosave; then
		if [ "$fresh" != true ] && has_checkpoint; then
			echo "q9: resuming pre-desktop checkpoint: $sessionstate" >&2
			"$qemu" -m "$mem" -smp "$smp" \
				-drive file="$driveimage",format=raw $snapshotarg \
				-device "$netdevice,netdev=net0,mac=$mac" \
				-netdev "user,id=net0,$u9fs,$tftp" \
				-monitor "unix:$monitorsock,server=on,wait=off" \
				-display gtk,window-close=on \
				-action shutdown=pause -no-shutdown \
				-incoming "exec:cat $sessionstate" "$@"
		else
			echo 'q9: no pre-desktop checkpoint; cold booting' >&2
			"$qemu" -m "$mem" -smp "$smp" \
				-drive file="$driveimage",format=raw $snapshotarg \
				-device "$netdevice,netdev=net0,mac=$mac" \
				-netdev "user,id=net0,$u9fs,$tftp" \
				-monitor "unix:$monitorsock,server=on,wait=off" \
				-display gtk,window-close=on \
				-action shutdown=pause -no-shutdown "$@"
		fi
	else
		"$qemu" -m "$mem" -smp "$smp" \
			-drive file="$driveimage",format=raw $snapshotarg \
			-device "$netdevice,netdev=net0,mac=$mac" \
			-netdev "user,id=net0,$u9fs,$tftp" "$@"
	fi
}

run_foreground()
{
	write_kernel_pxe
	build_u9fs
	prepare_drive_image
	if [ "$textonly" = true ]; then
		qemu_common -display none -serial stdio
	else
		qemu_common -serial stdio
	fi
}

wait_for_prompt()
{
	if [ "$profile" = true ]; then
		if [ "$hadsession" = true ]; then
			return 0
		fi
		i=0
		while [ "$i" -lt "$boottimeout" ]; do
			if [ -f "$seriallog" ] && grep -q 'q9: gui ready' "$seriallog"; then
				return 0
			fi
			sleep 1
			i=$((i + 1))
		done
		echo "q9: timed out waiting for graphical session; continuing without initial autosave" >&2
		return 0
	fi
	i=0
	while [ "$i" -lt "$boottimeout" ]; do
		if [ -f "$seriallog" ] && grep -q 'term% ' "$seriallog"; then
			return 0
		fi
		sleep 1
		i=$((i + 1))
	done
	echo "q9: timed out waiting for TaijiOS prompt; boot log follows" >&2
	tail -80 "$seriallog" >&2 || true
	return 1
}

run_clean()
{
	command -v socat >/dev/null 2>&1 || {
		echo 'q9: socat is required for the clean console; use --raw for direct QEMU stdio' >&2
		exit 1
	}
	if [ ! -t 0 ] || [ ! -t 1 ]; then
		echo 'q9: clean console needs a terminal; use --raw for non-interactive output' >&2
		exit 1
	fi
	if qemu_autosave; then
		acquire_runlock
		trap 'cleanup_runtime; clear_runrc' EXIT HUP INT TERM
	fi
	if [ "$profile" = true ] && [ "$textonly" != true ]; then
		write_predesktoprc
	fi
	write_kernel_pxe
	build_u9fs
	prepare_drive_image
	rm -f "$seriallog" "$serialsock" "$monitorsock" "$monitorlog"
	hadsession=false
	if qemu_autosave && [ "$fresh" != true ] && has_checkpoint; then
		hadsession=true
	fi
	if [ "$textonly" = true ]; then
		qemu_common \
			-display none \
			-chardev "socket,id=serial0,path=$serialsock,server=on,wait=on" \
			-serial chardev:serial0 \
			-monitor none >"$qemulog" 2>&1 &
	else
		if qemu_autosave; then
			qemu_common \
				-chardev "socket,id=serial0,path=$serialsock,server=on,wait=on" \
				-serial chardev:serial0 >"$qemulog" 2>&1 &
		else
			qemu_common \
				-chardev "socket,id=serial0,path=$serialsock,server=on,wait=on" \
				-serial chardev:serial0 \
				-monitor none >"$qemulog" 2>&1 &
		fi
	fi
	qemupid=$!
	wait_for_socket
	: >"$seriallog"
	socat -u "UNIX-CONNECT:$serialsock" "OPEN:$seriallog,creat,append" 2>"$socatlog" &
	logpid=$!
	if qemu_autosave; then
		if [ "$fresh" != true ] && has_checkpoint; then
			if wait_for_monitor && wait_for_incoming; then
				hmp 'cont' >/dev/null 2>&1 || true
			else
				echo 'q9: ignoring unusable checkpoint; run ./q9 again for a cold boot' >&2
				mv "$sessionmeta" "$sessionmeta.bad" 2>/dev/null || true
				kill -TERM "$qemupid" 2>/dev/null || true
				wait "$qemupid" 2>/dev/null || true
				cleanup_runtime
				clear_runrc
				exit 1
			fi
		fi
	else
		:
	fi
	trap 'kill -TERM "${logpid:-}" "$qemupid" 2>/dev/null || true; wait "${logpid:-}" 2>/dev/null || true; wait "$qemupid" 2>/dev/null || true; cleanup_runtime; clear_runrc' EXIT HUP INT TERM
	wait_for_prompt
	if qemu_autosave && [ "$hadsession" != true ]; then
		save_session continue
	fi
	kill -TERM "$logpid" 2>/dev/null || true
	wait "$logpid" 2>/dev/null || true
	wait_for_socket
	if [ "$mode" = run ]; then
		sed -n '/q9: running \/cfg\/q9\/run.rc/,$p' "$seriallog" | sed '$s/term% $//'
	fi
	if [ "$profile" != true ]; then
		printf 'term%% '
	fi
	socat -,rawer,echo=0 "UNIX-CONNECT:$serialsock" 2>>"$socatlog"
}

case "$mode" in
	console|shell)
		clear_runrc
		if [ "$raw" = true ]; then
			trap 'cleanup_runtime; clear_runrc' EXIT HUP INT TERM
			write_predesktoprc
			run_foreground
		else
		run_clean
	fi
	;;
run)
	if [ "$profile" = true ]; then
		echo 'q9: --gui boots the normal profile; it cannot be combined with run' >&2
		usage 1
	fi
	[ $# -gt 0 ] || usage
		write_runrc "$*"
		if [ "$raw" = true ]; then
			trap 'cleanup_runtime; clear_runrc' EXIT HUP INT TERM
			run_foreground
		else
		run_clean
	fi
	;;
	*)
		usage 1
	;;
esac
