bind -a $home/bin/rc /bin
bind -a $home/bin/$cputype /bin
bind -c tmp /tmp
if(! syscall create /tmp/xxx 1 0666 >[2]/dev/null)
	ramfs	# in case we're running off a cd
font = /lib/font/bit/pelm/euro.9.font
upas/fs
fn cd { builtin cd $* && awd }  # for acme
if(~ $q9unix 1){
	bind -a /$cputype/bin/ape /bin
	if(test -x /bin/git/compat){
		ramfs -m /n/gitcompat
		touch /n/gitcompat/git
		bind /bin/git/compat /n/gitcompat/git
		path=(/n/gitcompat $path)
	}
	fn ll { ls -l $* }
	fn la { ls -la $* }
	fn l { ls $* }
	fn cdup { cd .. }
	fn cls { echo }
	fn clear { echo }
	fn path { echo $path }
	fn which { for(i in $path) if(test -x $i/$1) echo $i/$1 }
	fn web { webfs && echo webfs mounted at /mnt/web }
	fn get { hget $* }
	if(test -r $home/lib/go.rc)
		. $home/lib/go.rc
	if(test -x /bin/q9kbapply)
		q9kbapply >/dev/null >[2=1]
}
switch($service){
case terminal
	plumber
	if(~ $q9unix 1)
		# linear: QEMU VNC maps absolute pointers with 1:1 deltas;
		# acceleration makes the guest cursor drift from the client's
		echo -n linear > '#m/mousectl'
	if not
		echo -n accelerated > '#m/mousectl'
	echo -n 'res 3' > '#m/mousectl'
	prompt=('term% ' '	')
	fn term%{ $* }
	if(~ $q9mode text){
		if(test -r /cfg/q9/run.rc)
			. /cfg/q9/run.rc
		exec rc
	}
	if(test -r /cfg/q9/predesktop.rc)
		. /cfg/q9/predesktop.rc
	while(){
		echo q9: gui ready
		startwm
		if(! ~ $status '')
			exec rc
	}
case cpu
	if (test -e /mnt/term/mnt/wsys) { # window system already running
		bind -a /mnt/term/mnt/wsys /dev
		if(test -w /dev/label)
			echo -n $sysname > /dev/label
	}
	bind /mnt/term/dev/cons /dev/cons
	bind /mnt/term/dev/consctl /dev/consctl
	bind -a /mnt/term/dev /dev
	prompt=('cpu% ' '	')
	fn cpu%{ $* }
	news
	if (! test -e /mnt/term/mnt/wsys) {	# cpu call from drawterm
		font=/lib/font/bit/pelm/latin1.8.font
		exec startwm
	}
case con
	prompt=('cpu% ' '	')
	news
}
