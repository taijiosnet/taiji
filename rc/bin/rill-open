#!/bin/rc
# rill-open file ... - open documents through the desktop application
# registry.  Each file is matched against /lib/rill/associations (and the
# user's $home/lib/rill/associations overrides); the winning application's
# registered Exec command is launched in a native window with the file
# appended.  Files opened by Debian applications are translated from the
# native $home tree into the Linux runtime's /home/user view.

if(~ $#* 0){
	echo 'usage: rill-open file ...' >[1=2]
	exit usage
}

fn fail {
	echo 'rill-open: '^$1 >[1=2]
	exit open
}

registry=/lib/rill/applications
if(test -r $home/lib/rill/applications)
	registry=$home/lib/rill/applications

# findapp suffix -> application id (user rules override the system's)
app=()
for(rules in $home/lib/rill/associations /lib/rill/associations){
	if(test -r $rules)
		app=`{awk -v s=$1 '$1==s && !/^#/ {print $2; exit}' $rules}
	if(~ $#app 1)
		break
}
if(~ $#app 0)
	fail 'no application registered for '^$1

# Resolve the registered Exec command into one argument per line, honoring
# its single-quoted titles.  rc splits the output into a clean word list,
# so no eval or re-quoting is needed anywhere below.
cmd=`{awk -v want=$app '
	/^[ \t]*\[/ { inentry = 0 }
	/^[ \t]*Id=/ { split($0, a, "="); inentry = (a[2] == want) }
	inentry && /^[ \t]*Exec=/ {
		s = $0; sub(/^[ \t]*Exec=/, "", s)
		i = 1; n = length(s)
		while (i <= n) {
			while (i <= n && substr(s, i, 1) ~ /[ \t]/) i++
			if (i > n) break
			w = ""
			while (i <= n && substr(s, i, 1) !~ /[ \t]/) {
				if (substr(s, i, 1) == "\x27") {
					i++
					while (i <= n && substr(s, i, 1) != "\x27") {
						w = w substr(s, i, 1); i++
					}
					i++
				} else {
					w = w substr(s, i, 1); i++
				}
			}
			print w
		}
		exit
	}
' $registry}
if(~ $#cmd 0)
	fail 'application is not registered: '^$app

# One window per file: each document gets its own instance.
for(f in $*){
	arg=$f
	if(~ $cmd *linux-app*){
		# Debian applications see the Linux view of the user's tree.
		rest=`{echo -n $f | sed 's|^'^$home^'|/home/user|'}
		if(! ~ $rest /*)
			fail 'Debian applications open files under '^$home
		arg=$rest
	}
	$cmd $arg
}
exit ''
